---
import { Image } from 'astro:assets';
import ExternalLink from '@lucide/astro/icons/external-link';
import Mail from '@lucide/astro/icons/mail';
import MapPin from '@lucide/astro/icons/map-pin';
import Smartphone from '@lucide/astro/icons/smartphone';
import logo from '../assets/images/logo-transparant.png';
import { bookingPath, hotel, mainNav } from '../data/hotel';
import { localePath, useTranslations, type Locale } from '../i18n';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const t = useTranslations(locale);
const nav = mainNav(locale);
const year = new Date().getFullYear();
---

<footer class="site-footer">
  <div class="container columns">
    <div class="about">
      <a href={localePath(locale, '/')} class="brand">
        <Image src={logo} alt="Hotel Claridge" width={150} densities={[1, 2]} />
      </a>
      <p>{t.footer.tagline}</p>
    </div>

    <div>
      <h2>{t.footer.contact}</h2>
      <ul class="contact-list">
        <li>
          <MapPin size={18} />
          <a href={hotel.mapsUrl} target="_blank" rel="noopener">
            {hotel.address.street}<br />{hotel.address.postalCode} {hotel.address.city}
            <span class="sr-only">{t.common.mapsHint}</span>
          </a>
        </li>
        <li>
          <Smartphone size={18} />
          <a href={hotel.mobile.href}>{hotel.mobile.label}</a>
        </li>
        <li>
          <Mail size={18} />
          <span class="emails">
            {hotel.emails.map((email) => <a href={`mailto:${email}`}>{email}</a>)}
          </span>
        </li>
      </ul>
    </div>

    <div>
      <h2>{t.footer.menu}</h2>
      <ul class="link-list">
        {nav.map(({ href, label }) => <li><a href={href}>{label}</a></li>)}
        <li><a href={bookingPath(locale)}>{t.nav.book}</a></li>
      </ul>
    </div>

    <div>
      <h2>{t.footer.direct}</h2>
      <p>{t.footer.directText}</p>
      <div class="actions">
        <a href={bookingPath(locale)} class="btn btn-light">{t.nav.book}</a>
        <a href={hotel.bookingUrl} class="external" target="_blank" rel="noopener">
          {t.common.bookingCom} <ExternalLink size={15} />
        </a>
      </div>
    </div>
  </div>

  <div class="container bottom">
    <p>&copy; {year} Hotel Claridge &middot; {t.footer.rights}</p>
  </div>
</footer>

<style>
  .site-footer {
    margin-top: auto;
    padding-top: clamp(3.5rem, 7vw, 5rem);
    background-color: var(--color-dark);
    color: var(--color-on-dark-muted);
    font-size: 0.97rem;
  }

  .columns {
    display: grid;
    grid-template-columns: 1.2fr 1.3fr 0.8fr 1.3fr;
    gap: 2.5rem;
    padding-bottom: 3rem;
  }

  .brand {
    display: inline-block;
    margin-bottom: 1.25rem;
  }

  /* Zwart logo wit maken op de donkere achtergrond */
  .brand :global(img) {
    width: 150px;
    filter: invert(1);
  }

  h2 {
    margin-bottom: 1.1rem;
    color: #fff;
    font-family: var(--font-sans);
    font-size: 0.8rem;
    font-weight: 600;
    letter-spacing: 0.16em;
    text-transform: uppercase;
  }

  ul {
    padding: 0;
    list-style: none;
  }

  a:not(.btn) {
    color: var(--color-on-dark);
    text-decoration: none;
  }

  a:not(.btn):hover {
    color: #fff;
    text-decoration: underline;
  }

  .contact-list li {
    display: flex;
    align-items: flex-start;
    gap: 0.75rem;
    margin-bottom: 0.8rem;
  }

  .contact-list :global(svg) {
    flex-shrink: 0;
    margin-top: 0.3rem;
    color: var(--color-accent-light);
  }

  .emails {
    display: grid;
    min-width: 0;
    overflow-wrap: anywhere;
  }

  .link-list li + li {
    margin-top: 0.5rem;
  }

  .actions {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 0.9rem;
    margin-top: 1.25rem;
  }

  .external {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
  }

  .bottom {
    padding-block: 1.5rem;
    border-top: 1px solid rgb(255 255 255 / 0.1);
    font-size: 0.88rem;
  }

  @media (max-width: 1000px) {
    .columns {
      grid-template-columns: 1fr 1fr;
    }
  }

  @media (max-width: 600px) {
    .columns {
      grid-template-columns: 1fr;
    }
  }
</style>
