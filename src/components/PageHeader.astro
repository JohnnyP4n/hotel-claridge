---
import type { ImageMetadata } from 'astro';
import { Image } from 'astro:assets';

interface Props {
  eyebrow?: string;
  title: string;
  intro?: string;
  image: ImageMetadata;
  /** Welk deel van de foto zichtbaar blijft, bv. 'center 30%' */
  imagePosition?: string;
}

const { eyebrow, title, intro, image, imagePosition = 'center' } = Astro.props;

// Nooit groter maken dan de originele foto
const width = Math.min(2400, image.width);
const widths = [640, 1024, 1600, 2400].filter((w) => w <= width);
---

<section class="page-header" style={`--focus: ${imagePosition}`}>
  <div class="media">
    <Image src={image} alt="" width={width} widths={widths} sizes="100vw" priority />
  </div>
  <div class="container content">
    {eyebrow && <p class="eyebrow">{eyebrow}</p>}
    <h1>{title}</h1>
    {intro && <p class="intro">{intro}</p>}
  </div>
</section>

<style>
  .page-header {
    position: relative;
    display: flex;
    align-items: flex-end;
    min-height: clamp(280px, 36vw, 420px);
    padding-block: clamp(2.5rem, 5vw, 4rem);
    overflow: hidden;
    color: #fff;
  }

  .media {
    position: absolute;
    inset: 0;
  }

  .media :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: var(--focus);
  }

  .media::after {
    content: '';
    position: absolute;
    inset: 0;
    background: linear-gradient(to top, rgb(21 34 32 / 0.88), rgb(21 34 32 / 0.35) 70%, rgb(21 34 32 / 0.25));
  }

  .content {
    position: relative;
  }

  .eyebrow {
    color: var(--color-accent-light);
  }

  h1 {
    color: #fff;
  }

  .intro {
    max-width: 620px;
    margin-top: 1rem;
    color: rgb(255 255 255 / 0.88);
    font-size: 1.15rem;
  }
</style>
