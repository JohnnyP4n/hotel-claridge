---
// Twee aparte bedden, getekend in dezelfde stijl als de Lucide-iconen
// (Lucide heeft zelf enkel een icoon voor één bed).
// Zelfde hoogtes als Lucide's bed-double; elk bed is ongeveer 60% zo breed,
// daarom is het icoon breder dan hoog.
interface Props {
  size?: number;
}

const { size = 24 } = Astro.props;
---

<svg
  xmlns="http://www.w3.org/2000/svg"
  width={(size * 32) / 24}
  height={size}
  viewBox="0 0 32 24"
  fill="none"
  stroke="currentColor"
  stroke-width="2"
  stroke-linecap="round"
  stroke-linejoin="round"
  aria-hidden="true"
>
  <path d="M2 20v-8a2 2 0 0 1 2-2h8a2 2 0 0 1 2 2v8" />
  <path d="M4 10V6a2 2 0 0 1 2-2h4a2 2 0 0 1 2 2v4" />
  <path d="M2 18h12" />
  <path d="M18 20v-8a2 2 0 0 1 2-2h8a2 2 0 0 1 2 2v8" />
  <path d="M20 10V6a2 2 0 0 1 2-2h4a2 2 0 0 1 2 2v4" />
  <path d="M18 18h12" />
</svg>
