---
import { Image } from 'astro:assets';
import Menu from '@lucide/astro/icons/menu';
import X from '@lucide/astro/icons/x';
import logo from '../assets/images/logo-transparant.png';
import { bookingPath, mainNav } from '../data/hotel';
import { localeLinks, localePath, useTranslations, type Locale } from '../i18n';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const t = useTranslations(locale);
const nav = mainNav(locale);
// Dezelfde pagina in de andere talen, bv. /tarieven/ wordt /fr/tarieven/
const languages = localeLinks(Astro.url);

// Slash op het einde weglaten, zodat /kamers en /kamers/ allebei als actief tellen
const withoutSlash = (path: string) => path.replace(/\/$/, '') || '/';
const currentPath = withoutSlash(Astro.url.pathname);
---

<header class="site-header">
  <div class="container inner">
    <a href={localePath(locale, '/')} class="brand">
      <Image src={logo} alt="Hotel Claridge" width={110} densities={[1, 2]} priority />
    </a>

    <button type="button" class="menu-toggle" aria-expanded="false" aria-controls="site-nav">
      <span class="icon-open"><Menu size={22} /></span>
      <span class="icon-close"><X size={22} /></span>
      <span class="sr-only">{t.nav.menu}</span>
    </button>

    <nav id="site-nav" class="site-nav" aria-label={t.nav.label}>
      <ul>
        {nav.map(({ href, label }) => (
          <li>
            <a href={href} aria-current={withoutSlash(href) === currentPath ? 'page' : undefined}>{label}</a>
          </li>
        ))}
      </ul>
      <a href={bookingPath(locale)} class="btn btn-primary">{t.nav.book}</a>
    </nav>

    <nav class="lang" aria-label={t.nav.language}>
      <ul>
        {languages.map((language) => (
          <li>
            <a
              href={language.href}
              hreflang={language.locale}
              lang={language.locale}
              aria-current={language.locale === locale ? 'true' : undefined}
            >
              <span aria-hidden="true">{language.locale.toUpperCase()}</span>
              <span class="sr-only">{language.name}</span>
            </a>
          </li>
        ))}
      </ul>
    </nav>
  </div>
</header>

<script>
  const header = document.querySelector<HTMLElement>('.site-header');
  const toggle = header?.querySelector<HTMLButtonElement>('.menu-toggle');

  function setMenuOpen(open: boolean) {
    header?.classList.toggle('is-open', open);
    toggle?.setAttribute('aria-expanded', String(open));
  }

  toggle?.addEventListener('click', () => {
    setMenuOpen(toggle.getAttribute('aria-expanded') !== 'true');
  });

  // Menu sluiten met Escape
  document.addEventListener('keydown', (event) => {
    if (event.key === 'Escape' && header?.classList.contains('is-open')) {
      setMenuOpen(false);
      toggle?.focus();
    }
  });
</script>

<style>
  .site-header {
    position: sticky;
    top: 0;
    z-index: 50;
    background-color: rgb(255 255 255 / 0.94);
    border-bottom: 1px solid var(--color-line);
    backdrop-filter: saturate(1.4) blur(10px);
  }

  .inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1.5rem;
    height: var(--header-height);
  }

  .brand {
    flex-shrink: 0;
    margin-right: auto;
  }

  .brand :global(img) {
    width: 110px;
  }

  .site-nav {
    display: flex;
    align-items: center;
    gap: 1.5rem;
  }

  .site-nav ul {
    display: flex;
    gap: 0.25rem;
    padding: 0;
    list-style: none;
  }

  .site-nav ul a {
    position: relative;
    display: block;
    padding: 0.5rem 0.9rem;
    color: var(--color-heading);
    font-weight: 500;
    text-decoration: none;
  }

  .site-nav ul a:hover,
  .site-nav ul a[aria-current='page'] {
    color: var(--color-primary);
  }

  .site-nav ul a[aria-current='page']::after {
    content: '';
    position: absolute;
    right: 0.9rem;
    bottom: 0.15rem;
    left: 0.9rem;
    height: 2px;
    border-radius: 2px;
    background-color: currentColor;
  }

  /* Taalkeuze: NL FR EN DE, altijd zichtbaar (ook naast het hamburgermenu) */
  .lang ul {
    display: flex;
    gap: 0.15rem;
    padding: 0;
    list-style: none;
  }

  .lang a {
    display: block;
    padding: 0.3rem 0.45rem;
    color: var(--color-muted);
    border-radius: var(--radius-sm);
    font-size: 0.8rem;
    font-weight: 600;
    letter-spacing: 0.04em;
    text-decoration: none;
  }

  .lang a:hover {
    background-color: var(--color-primary-soft);
    color: var(--color-primary);
  }

  .lang a[aria-current='true'] {
    background-color: var(--color-primary-soft);
    color: var(--color-primary-dark);
  }

  .menu-toggle {
    display: none;
  }

  /* Gsm en kleine tablet: inklapbaar menu */
  @media (max-width: 860px) {
    .inner {
      gap: 0.75rem;
    }

    /* De knop staat in de code vóór het menu, maar op het scherm helemaal rechts */
    .menu-toggle {
      order: 1;
      display: inline-flex;
      align-items: center;
      justify-content: center;
      width: 46px;
      height: 46px;
      background-color: #fff;
      color: var(--color-heading);
      border: 1px solid var(--color-line);
      border-radius: 12px;
      cursor: pointer;
    }

    .icon-close,
    .is-open .icon-open {
      display: none;
    }

    .is-open .icon-close {
      display: block;
    }

    .site-nav {
      position: absolute;
      top: 100%;
      right: 0;
      left: 0;
      display: none;
      flex-direction: column;
      align-items: stretch;
      gap: 1.25rem;
      padding: 0.5rem var(--gutter) 1.5rem;
      background-color: #fff;
      border-bottom: 1px solid var(--color-line);
      box-shadow: var(--shadow);
    }

    .is-open .site-nav {
      display: flex;
    }

    .site-nav ul {
      flex-direction: column;
    }

    .site-nav ul a {
      padding: 0.9rem 0.25rem;
      border-bottom: 1px solid var(--color-line);
      font-size: 1.1rem;
    }

    .site-nav ul a[aria-current='page']::after {
      display: none;
    }
  }

  /* Smalle gsm: logo iets kleiner, zodat de taalkeuze ernaast past */
  @media (max-width: 400px) {
    .brand :global(img) {
      width: 90px;
    }

    .lang a {
      padding: 0.3rem 0.3rem;
    }
  }
</style>
