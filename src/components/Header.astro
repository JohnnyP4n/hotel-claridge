---
import { Image } from 'astro:assets';
import Menu from '@lucide/astro/icons/menu';
import X from '@lucide/astro/icons/x';
import logo from '../assets/images/logo-transparant.png';
import { bookingPath, mainNav } from '../data/hotel';
import { withBase } from '../utils/paths';

// Slash op het einde weglaten, zodat /kamers en /kamers/ allebei als actief tellen
const withoutSlash = (path: string) => path.replace(/\/$/, '') || '/';
const currentPath = withoutSlash(Astro.url.pathname);
---

<header class="site-header">
  <div class="container inner">
    <a href={withBase('/')} class="brand">
      <Image src={logo} alt="Hotel Claridge" width={110} densities={[1, 2]} priority />
    </a>

    <button type="button" class="menu-toggle" aria-expanded="false" aria-controls="site-nav">
      <span class="icon-open"><Menu size={22} /></span>
      <span class="icon-close"><X size={22} /></span>
      <span class="sr-only">Menu</span>
    </button>

    <nav id="site-nav" class="site-nav" aria-label="Hoofdmenu">
      <ul>
        {mainNav.map(({ href, label }) => (
          <li>
            <a href={href} aria-current={withoutSlash(href) === currentPath ? 'page' : undefined}>{label}</a>
          </li>
        ))}
      </ul>
      <a href={bookingPath} class="btn btn-primary">Vraag verblijf aan</a>
    </nav>
  </div>
</header>

<script>
  const header = document.querySelector<HTMLElement>('.site-header');
  const toggle = header?.querySelector<HTMLButtonElement>('.menu-toggle');

  function setMenuOpen(open: boolean) {
    header?.classList.toggle('is-open', open);
    toggle?.setAttribute('aria-expanded', String(open));
  }

  toggle?.addEventListener('click', () => {
    setMenuOpen(toggle.getAttribute('aria-expanded') !== 'true');
  });

  // Menu sluiten met Escape
  document.addEventListener('keydown', (event) => {
    if (event.key === 'Escape' && header?.classList.contains('is-open')) {
      setMenuOpen(false);
      toggle?.focus();
    }
  });
</script>

<style>
  .site-header {
    position: sticky;
    top: 0;
    z-index: 50;
    background-color: rgb(255 255 255 / 0.94);
    border-bottom: 1px solid var(--color-line);
    backdrop-filter: saturate(1.4) blur(10px);
  }

  .inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 2rem;
    height: var(--header-height);
  }

  .brand {
    flex-shrink: 0;
  }

  .brand :global(img) {
    width: 110px;
  }

  .site-nav {
    display: flex;
    align-items: center;
    gap: 1.5rem;
  }

  .site-nav ul {
    display: flex;
    gap: 0.25rem;
    padding: 0;
    list-style: none;
  }

  .site-nav ul a {
    position: relative;
    display: block;
    padding: 0.5rem 0.9rem;
    color: var(--color-heading);
    font-weight: 500;
    text-decoration: none;
  }

  .site-nav ul a:hover,
  .site-nav ul a[aria-current='page'] {
    color: var(--color-primary);
  }

  .site-nav ul a[aria-current='page']::after {
    content: '';
    position: absolute;
    right: 0.9rem;
    bottom: 0.15rem;
    left: 0.9rem;
    height: 2px;
    border-radius: 2px;
    background-color: currentColor;
  }

  .menu-toggle {
    display: none;
  }

  /* Gsm en kleine tablet: inklapbaar menu */
  @media (max-width: 860px) {
    .menu-toggle {
      display: inline-flex;
      align-items: center;
      justify-content: center;
      width: 46px;
      height: 46px;
      background-color: #fff;
      color: var(--color-heading);
      border: 1px solid var(--color-line);
      border-radius: 12px;
      cursor: pointer;
    }

    .icon-close,
    .is-open .icon-open {
      display: none;
    }

    .is-open .icon-close {
      display: block;
    }

    .site-nav {
      position: absolute;
      top: 100%;
      right: 0;
      left: 0;
      display: none;
      flex-direction: column;
      align-items: stretch;
      gap: 1.25rem;
      padding: 0.5rem var(--gutter) 1.5rem;
      background-color: #fff;
      border-bottom: 1px solid var(--color-line);
      box-shadow: var(--shadow);
    }

    .is-open .site-nav {
      display: flex;
    }

    .site-nav ul {
      flex-direction: column;
    }

    .site-nav ul a {
      padding: 0.9rem 0.25rem;
      border-bottom: 1px solid var(--color-line);
      font-size: 1.1rem;
    }

    .site-nav ul a[aria-current='page']::after {
      display: none;
    }
  }
</style>
