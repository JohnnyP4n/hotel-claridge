---
import Layout from '../layouts/Layout.astro';
---

<Layout title="Tarieven">
  <main>
    <div class="container">
      <section id="rates">
        <h2>Tarieven</h2>

        <table class="rates-table">
          <thead>
            <tr>
              <th>Type kamer</th>
              <th>Laagseizoen<br /><small>vanaf</small></th>
              <th>Hoogseizoen<br /><small>vanaf</small></th>
            </tr>
          </thead>
          <tbody>
            <tr>
              <td>Type A: Comfortkamer met bad/toilet - tweepersoonsbed</td>
              <td>&euro; 110</td>
              <td>&euro; 120</td>
            </tr>
            <tr>
              <td>Type B: Comfortkamer met douche/toilet - twee aparte bedden</td>
              <td>&euro; 110</td>
              <td>&euro; 120</td>
            </tr>
            <tr>
              <td>Type C: Standaardkamer met douche/toilet - tweepersoonsbed</td>
              <td>&euro; 90</td>
              <td>&euro; 100</td>
            </tr>
            <tr>
              <td>Familiekamer (4 personen)</td>
              <td>&euro; 200</td>
              <td>&euro; 230</td>
            </tr>
          </tbody>
        </table>

        <h3>Extra bedden (niet mogelijk bij Type C)</h3>
        <ul class="rates-children">
          <li>Geen extra bed (0 - 2 jaar): gratis</li>
          <li>Babybedje (0 - 2 jaar): &euro; 20</li>
          <li>Kinderbed (3 - 12 jaar): &euro; 30</li>
          <li>Eenpersoonsbed (vanaf 12 jaar): &euro; 40</li>
        </ul>

        <div class="rate-info">
          <p><strong>Inbegrepen:</strong> ontbijt, TV, gratis WiFi en haardroger.</p>
          <p><strong>Extra bij type A, B en familiekamer:</strong> minibar en waterkoker.</p>
          <p><strong>Toeristenbelasting:</strong> &euro; 2,50 per persoon per nacht (niet inbegrepen).</p>
        </div>
      </section>
    </div>
  </main>
</Layout>
