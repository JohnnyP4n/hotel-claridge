---
import Mail from '@lucide/astro/icons/mail';
import MapPin from '@lucide/astro/icons/map-pin';
import Smartphone from '@lucide/astro/icons/smartphone';
import TrainFront from '@lucide/astro/icons/train-front';
import PageHeader from '../components/PageHeader.astro';
import Layout from '../layouts/Layout.astro';
import headerImage from '../assets/images/pier.jpg';
import { hotel } from '../data/hotel';
---

<Layout
  title="Contact"
  description="Contacteer Hotel Claridge, de Limburg Stirumstraat 2, 8370 Blankenberge. Bel +32 476 68 88 88 of stuur ons een e-mail."
>
  <PageHeader
    eyebrow="Contact"
    title="Contacteer ons"
    intro="Een vraag over uw verblijf? Wij helpen u graag verder."
    image={headerImage}
  />

  <section class="section" id="contact">
    <div class="container contact-grid">
      <div class="details">
        <h2>Contactgegevens</h2>
        <ul class="contact-list">
          <li>
            <span class="icon"><MapPin size={20} /></span>
            <div>
              <strong>Adres</strong>
              <span>{hotel.name}<br />{hotel.address.street}<br />{hotel.address.postalCode} {hotel.address.city}</span>
            </div>
          </li>
          <li>
            <span class="icon"><Smartphone size={20} /></span>
            <div>
              <strong>Gsm</strong>
              <a href={hotel.mobile.href}>{hotel.mobile.label}</a>
            </div>
          </li>
          <li>
            <span class="icon"><Mail size={20} /></span>
            <div>
              <strong>E-mail</strong>
              {hotel.emails.map((email) => <a href={`mailto:${email}`}>{email}</a>)}
            </div>
          </li>
        </ul>

        <p class="happytrip-note">
          <TrainFront size={22} />
          <span>Ben je van plan met de trein te komen? Laat het ons weten bij je reservatie en ontvang een <strong>Happy Trip kortingscode</strong> voor je reis!</span>
        </p>
      </div>

      <div class="form-card card">
        <h2>Stuur ons een bericht</h2>
        <form id="contact-form">
          <div class="field">
            <label for="contact-name">Naam</label>
            <input type="text" id="contact-name" autocomplete="name" required />
          </div>
          <div class="field">
            <label for="contact-email">E-mail</label>
            <input type="email" id="contact-email" autocomplete="email" required />
          </div>
          <div class="field">
            <label for="contact-message">Bericht</label>
            <textarea id="contact-message" required></textarea>
          </div>
          <button type="submit" class="btn btn-primary">Verstuur</button>
        </form>
      </div>
    </div>

    <div class="container">
      <div class="map card">
        <iframe
          src={hotel.mapEmbedUrl}
          title="Ligging van Hotel Claridge op Google Maps"
          allowfullscreen=""
          loading="lazy"
          referrerpolicy="no-referrer-when-downgrade"
        ></iframe>
      </div>
    </div>
  </section>
</Layout>

<style>
  .contact-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: clamp(2rem, 5vw, 4rem);
    align-items: start;
  }

  h2 {
    margin-bottom: 1.75rem;
    font-size: clamp(1.9rem, 3vw, 2.4rem);
  }

  .contact-list {
    display: grid;
    gap: 1.5rem;
    padding: 0;
    list-style: none;
  }

  .contact-list li {
    display: flex;
    align-items: flex-start;
    gap: 1rem;
  }

  .contact-list div {
    display: grid;
    min-width: 0;
    overflow-wrap: anywhere;
  }

  .contact-list strong {
    font-size: 0.8rem;
    letter-spacing: 0.12em;
    text-transform: uppercase;
  }

  .contact-list a {
    color: var(--color-text);
    text-decoration: none;
  }

  .contact-list a:hover {
    color: var(--color-primary);
    text-decoration: underline;
  }

  .icon {
    display: inline-flex;
    flex-shrink: 0;
    align-items: center;
    justify-content: center;
    width: 46px;
    height: 46px;
    background-color: var(--color-primary-soft);
    color: var(--color-primary);
    border-radius: 999px;
  }

  .happytrip-note {
    display: flex;
    align-items: center;
    gap: 1rem;
    margin-top: 2.5rem;
    padding: 1.25rem 1.5rem;
    background-color: var(--color-sand);
    border-radius: var(--radius);
  }

  .happytrip-note :global(svg) {
    flex-shrink: 0;
    color: var(--color-primary);
  }

  .form-card {
    padding: clamp(1.5rem, 4vw, 2.5rem);
  }

  form {
    display: grid;
    gap: 1.25rem;
  }

  form .btn {
    justify-self: start;
  }

  .map {
    margin-top: clamp(3rem, 6vw, 4.5rem);
    overflow: hidden;
  }

  .map iframe {
    display: block;
    width: 100%;
    aspect-ratio: 21 / 9;
    border: 0;
  }

  @media (max-width: 860px) {
    .contact-grid {
      grid-template-columns: 1fr;
    }

    .map iframe {
      aspect-ratio: 1 / 1;
    }
  }
</style>
