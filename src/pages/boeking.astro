---
import Layout from '../layouts/Layout.astro';
---

<Layout title="Boeking">
  <main>
    <div class="container">
      <section id="booking">
        <h2>Vraag uw verblijf aan</h2>
        <p class="booking-intro">
          Vul onderstaand formulier in om een verblijf aan te vragen.<br />
          Wij controleren de beschikbaarheid en nemen zo snel mogelijk contact met u op.
        </p>

        <form id="booking-form" action="https://api.web3forms.com/submit" method="POST">
          <input type="hidden" name="access_key" value="15a448c6-8d0b-4075-8d79-1e58ddbfc27b" />

          <fieldset>
            <legend>Jouw Gegevens</legend>

            <label for="name">Naam:</label>
            <input type="text" id="name" name="name" required />

            <label for="email">E-mail:</label>
            <input type="email" id="email" name="email" required />

            <label for="phone">GSM-nummer (optioneel):</label>
            <input type="tel" id="phone" name="phone" placeholder="bijv. +32 123 45 67 89" />
          </fieldset>

          <fieldset>
            <legend>Uw Aanvraag</legend>

            <label for="checkin">Aankomstdatum:</label>
            <input type="date" id="checkin" name="checkin" required />

            <label for="checkout">Vertrekdatum:</label>
            <input type="date" id="checkout" name="checkout" required />

            <label for="guests">Aantal Personen:</label>
            <input type="number" id="guests" name="guests" min="1" max="4" required />

            <label for="room-type">Gewenste Kamertype:</label>
            <select id="room-type" name="room-type" required>
              <option value="" disabled selected hidden>Kies een kamer</option>
              <option value="Type A">Type A - Comfortkamer met bad/toilet</option>
              <option value="Type B">Type B - Comfortkamer met douche/toilet</option>
              <option value="Type C">Type C - Standaardkamer met douche/toilet</option>
              <option value="Familiekamer">Familiekamer</option>
            </select>

            <label for="remarks">Opmerkingen (optioneel):</label>
            <textarea id="remarks" name="remarks" rows="4"></textarea>
          </fieldset>

          <button type="submit">Vraag verblijf aan</button>
        </form>
      </section>
    </div>
  </main>
</Layout>

<script>
  import '../scripts/boeking.js';
</script>
