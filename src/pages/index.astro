---
import { Image } from 'astro:assets';
import Layout from '../layouts/Layout.astro';
import beach from '../assets/images/strand.jpg';
import happyTripBanner from '../assets/images/happytrip-banner.jpg';
---

<Layout>
  <!-- Inhoud homepage -->
  <header>
    <div class="hero">
      <Image src={beach} alt="" class="hero-bg" width={2400} widths={[640, 1024, 1600, 2400]} sizes="100vw" priority />
      <div class="overlay">
        <h1>Hotel Claridge</h1>
        <p>Charmant verblijf in het hart van Blankenberge</p>
        <div class="cta-button-group">
          <a href="/contact/" class="cta-button">Contacteer ons</a>
          <a href="https://www.booking.com/hotel/be/claridge.nl.html" target="_blank" class="cta-button booking-button">Booking.com</a>
        </div>
      </div>
    </div>
  </header>

  <main class="container">
    <section id="intro">
      <h2>Welkom bij Hotel Claridge</h2>
      <p><strong>Hotel Claridge</strong> is een charmant hotel in het hart van Blankenberge,
        rustig gelegen tussen de jachthaven en het station, op slechts <strong>200 meter van het strand</strong>.</p>

      <p>Dankzij onze <strong>centrale ligging</strong> bereikt u vlot de zee, winkels, restaurants en bezienswaardigheden.
        Perfect voor een ontspannen verblijf aan de Belgische kust.</p>

      <p>Wij bieden <strong>comfortabele kamers, een hartelijke service en een huiselijke sfeer</strong>.
        Ideaal voor een romantisch weekendje, familievakantie of een verfrissende break aan zee.</p>

      <p>Elke ochtend verwennen wij u met een vers <strong>ontbijt</strong>, inclusief dagelijks
        <strong>vers gebakken eieren met spek</strong> en gekookte eieren – een heerlijke start van uw dag!</p>

      <p>Kom <strong>genieten</strong> van de frisse zeelucht, het zachte zand en de warme gastvrijheid van Hotel Claridge.
        Wij kijken ernaar uit u te mogen ontvangen!</p>
    </section>

    <section id="happytrip" class="highlight">
      <Image src={happyTripBanner} alt="Happy Trip voordeel" class="happytrip-img" />
      <div class="happytrip-text">
        <h2>Happy Trip voordeel voor onze gasten</h2>
        <p>
          Boek rechtstreeks bij ons en ontvang <strong>kortingscodes</strong> voor je treinreis naar de kust!<br />
          Slechts € 14 heen en terug, vanuit élk Belgisch station. Geen parkeerstress. Geen extra kosten.
        </p>
        <p><strong>Vraag je Happy Trip-korting aan bij je boeking!</strong></p>
      </div>
    </section>
  </main>
</Layout>
