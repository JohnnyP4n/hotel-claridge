---
import Check from '@lucide/astro/icons/check';
import TrainFront from '@lucide/astro/icons/train-front';
import CtaBand from '../../components/CtaBand.astro';
import PageHeader from '../../components/PageHeader.astro';
import RoomCard from '../../components/RoomCard.astro';
import Layout from '../../layouts/Layout.astro';
import headerImage from '../../assets/images/kamermetbad.jpeg';
import { rooms } from '../../data/rooms';
import { localeStaticPaths, useTranslations, type Locale } from '../../i18n';

// Maakt deze pagina aan in elke taal: /kamers/, /fr/kamers/, /en/kamers/ en /de/kamers/
export const getStaticPaths = localeStaticPaths;

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const t = useTranslations(locale);
---

<Layout locale={locale} title={t.rooms.title} description={t.rooms.description}>
  <PageHeader
    eyebrow={t.rooms.eyebrow}
    title={t.rooms.heading}
    intro={t.rooms.intro}
    image={headerImage}
    imagePosition="center 60%"
  />

  <section class="section">
    <div class="container">
      <div class="included card">
        <h2>{t.rooms.included}</h2>
        <ul>
          {t.rooms.includedItems.map((item) => <li><Check size={18} /> {item}</li>)}
        </ul>
      </div>

      <div class="rooms-grid">
        {rooms.map((room) => <RoomCard locale={locale} room={room} />)}
      </div>

      <p class="happytrip-note">
        <TrainFront size={22} />
        <span set:html={t.rooms.happytripNoteHtml} />
      </p>
    </div>
  </section>

  <CtaBand locale={locale} />
</Layout>

<style>
  .included {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 1rem 2rem;
    margin-bottom: 2.5rem;
    padding: 1.5rem 2rem;
  }

  .included h2 {
    font-size: 1.5rem;
  }

  .included ul {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem 1.5rem;
    padding: 0;
    list-style: none;
  }

  .included li {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    font-weight: 500;
  }

  .included :global(svg) {
    color: var(--color-primary);
  }

  .rooms-grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 2rem;
  }

  .happytrip-note {
    display: flex;
    align-items: center;
    gap: 1rem;
    margin-top: 2.5rem;
    padding: 1.25rem 1.5rem;
    background-color: var(--color-sand);
    border-radius: var(--radius);
  }

  .happytrip-note :global(svg) {
    flex-shrink: 0;
    color: var(--color-primary);
  }

  @media (max-width: 820px) {
    .rooms-grid {
      grid-template-columns: 1fr;
    }

    .included {
      padding: 1.5rem;
    }
  }
</style>
