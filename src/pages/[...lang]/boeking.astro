---
import CalendarCheck from '@lucide/astro/icons/calendar-check';
import CircleCheck from '@lucide/astro/icons/circle-check';
import Coffee from '@lucide/astro/icons/coffee';
import ExternalLink from '@lucide/astro/icons/external-link';
import Phone from '@lucide/astro/icons/phone';
import TrainFront from '@lucide/astro/icons/train-front';
import PageHeader from '../../components/PageHeader.astro';
import Layout from '../../layouts/Layout.astro';
import headerImage from '../../assets/images/strand.jpg';
import { hotel } from '../../data/hotel';
import { rooms } from '../../data/rooms';
import { localeStaticPaths, useTranslations, type Locale } from '../../i18n';

// Maakt deze pagina aan in elke taal: /boeking/, /fr/boeking/, /en/boeking/ en /de/boeking/
export const getStaticPaths = localeStaticPaths;

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const t = useTranslations(locale);

// Het eigen script bij Cloudflare (map worker/) mailt de aanvraag naar het hotel en een
// bevestiging naar de gast, in de taal van de bezoeker. Ook lokaal (npm run dev): elke
// test verstuurt dus echte mails.
const formEndpoint = 'https://hotel-claridge-aanvraag.hotelclaridge.workers.dev';

// Cloudflare Turnstile houdt spambots tegen. De sitekey is openbaar; de geheime sleutel staat
// bij het script. De widget laat johnnyp4n.github.io en localhost toe.
const turnstileSiteKey = '0x4AAAAAAE86cn95It_fBqiX';
---

<Layout locale={locale} title={t.booking.title} description={t.booking.description}>
  <PageHeader
    eyebrow={t.booking.eyebrow}
    title={t.booking.heading}
    intro={t.booking.intro}
    image={headerImage}
    imagePosition="center 65%"
  />

  <section class="section" id="booking">
    <div class="container booking-grid">
      <!-- src/scripts/boeking.js verstuurt het formulier zonder de pagina te verlaten en
           leest de teksten hieronder uit de data-attributen, zodat het script zelf
           geen vertalingen bevat -->
      <form
        id="booking-form"
        class="card"
        action={formEndpoint}
        method="POST"
        data-lang={locale}
        data-submit={t.booking.submit}
        data-sending={t.booking.sending}
        data-dates-missing={t.booking.datesMissing}
        data-dates-order={t.booking.datesOrder}
      >
        <!-- Spamval: onzichtbaar voor bezoekers, spambots vinken dit aan -->
        <input type="checkbox" name="botcheck" class="botcheck" tabindex="-1" autocomplete="off" aria-hidden="true" />

        <fieldset>
          <legend>{t.booking.yourDetails}</legend>
          <div class="fields">
            <div class="field wide">
              <label for="name">{t.booking.name}</label>
              <input type="text" id="name" name="name" autocomplete="name" required />
            </div>
            <div class="field">
              <label for="email">{t.booking.email}</label>
              <input type="email" id="email" name="email" autocomplete="email" required />
            </div>
            <div class="field">
              <label for="phone">{t.booking.phone} <span class="optional">{t.booking.optional}</span></label>
              <input type="tel" id="phone" name="phone" autocomplete="tel" placeholder={t.booking.phonePlaceholder} />
            </div>
          </div>
        </fieldset>

        <fieldset>
          <legend>{t.booking.yourRequest}</legend>
          <div class="fields">
            <div class="field">
              <label for="checkin">{t.booking.checkin}</label>
              <input type="date" id="checkin" name="checkin" required />
            </div>
            <div class="field">
              <label for="checkout">{t.booking.checkout}</label>
              <input type="date" id="checkout" name="checkout" required />
            </div>
            <div class="field">
              <label for="guests">{t.booking.guests}</label>
              <input type="number" id="guests" name="guests" min="1" max="4" required />
            </div>
            <div class="field">
              <label for="room-type">{t.booking.roomType}</label>
              <select id="room-type" name="room-type" required>
                <option value="" disabled selected hidden>{t.booking.chooseRoom}</option>
                {rooms.map((room) => (
                  <option value={room.code}>
                    {room.showCode ? `${room.code} - ${t.rooms.items[room.id].name}` : t.rooms.items[room.id].name}
                  </option>
                ))}
              </select>
            </div>
            <div class="field wide">
              <label for="remarks">{t.booking.remarks} <span class="optional">{t.booking.optional}</span></label>
              <textarea id="remarks" name="remarks" rows="4"></textarea>
            </div>
          </div>
        </fieldset>

        <div class="submit">
          <!-- Spamcontrole van Cloudflare: meestal meteen "gelukt", soms vraagt ze een klik -->
          <div class="cf-turnstile" data-sitekey={turnstileSiteKey} data-language={t.turnstile} data-size="flexible"></div>
          <p id="booking-check" class="form-error" role="alert" hidden>{t.booking.robotCheck}</p>
          <p id="booking-error" class="form-error" role="alert" hidden>
            {t.booking.error} <a href={hotel.mobile.href}>{hotel.mobile.label}</a>.
          </p>
          <button type="submit" class="btn btn-primary">{t.booking.submit}</button>
        </div>
      </form>

      <div id="booking-sent" class="card sent" tabindex="-1" hidden>
        <CircleCheck size={40} />
        <h2>{t.booking.sent.title}</h2>
        <p>{t.booking.sent.text}</p>
        <p>{t.booking.sent.mail}</p>
      </div>

      <aside class="aside">
        <div class="card aside-card">
          <h2>{t.booking.aside.title}</h2>
          <ul>
            <li>
              <CalendarCheck size={20} />
              <span>{t.booking.aside.availability}</span>
            </li>
            <li>
              <Coffee size={20} />
              <span>{t.booking.aside.breakfast}</span>
            </li>
            <li>
              <TrainFront size={20} />
              <span set:html={t.booking.aside.trainHtml} />
            </li>
          </ul>
        </div>

        <div class="card aside-card">
          <h2>{t.booking.aside.phoneTitle}</h2>
          <a href={hotel.mobile.href} class="phone"><Phone size={20} /> {hotel.mobile.label}</a>
          <a href={hotel.bookingUrl} target="_blank" rel="noopener" class="external">
            {t.common.bookingCom} <ExternalLink size={15} />
          </a>
        </div>
      </aside>
    </div>
  </section>
</Layout>

<script is:inline src="https://challenges.cloudflare.com/turnstile/v0/api.js" async defer></script>
<script>
  import '../../scripts/boeking.js';
</script>

<style>
  .booking-grid {
    display: grid;
    grid-template-columns: minmax(0, 1fr) 340px;
    gap: 2rem;
    align-items: start;
  }

  #booking-form {
    display: grid;
    gap: 2.5rem;
    padding: clamp(1.5rem, 4vw, 2.75rem);
  }

  fieldset + fieldset {
    padding-top: 2.5rem;
    border-top: 1px solid var(--color-line);
  }

  .fields {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 1.25rem;
  }

  .wide {
    grid-column: 1 / -1;
  }

  .botcheck {
    display: none;
  }

  .submit {
    display: grid;
    gap: 1rem;
  }

  #booking-form .btn {
    justify-self: start;
    min-width: 220px;
  }

  #booking-form .btn:disabled {
    opacity: 0.7;
    cursor: wait;
  }

  .form-error {
    padding: 0.85rem 1rem;
    background-color: var(--color-error-soft);
    color: var(--color-error);
    border-radius: var(--radius-sm);
    font-size: 0.97rem;
  }

  .form-error a {
    color: inherit;
    font-weight: 600;
    white-space: nowrap;
  }

  .sent {
    display: grid;
    justify-items: start;
    gap: 1rem;
    padding: clamp(1.5rem, 4vw, 2.75rem);
  }

  .sent:focus {
    outline: none;
  }

  .sent :global(svg) {
    color: var(--color-primary);
  }

  .aside {
    position: sticky;
    top: calc(var(--header-height) + 1.5rem);
    display: grid;
    gap: 1.5rem;
  }

  .aside-card {
    padding: 1.75rem;
  }

  .aside-card h2 {
    margin-bottom: 1.25rem;
    font-size: 1.6rem;
  }

  .aside-card ul {
    display: grid;
    gap: 1rem;
    padding: 0;
    list-style: none;
  }

  .aside-card li {
    display: flex;
    align-items: flex-start;
    gap: 0.85rem;
    font-size: 0.97rem;
  }

  .aside-card li :global(svg) {
    flex-shrink: 0;
    margin-top: 0.2rem;
    color: var(--color-primary);
  }

  .phone {
    display: inline-flex;
    align-items: center;
    gap: 0.6rem;
    color: var(--color-heading);
    font-family: var(--font-serif);
    font-size: 1.6rem;
    font-weight: 700;
    font-variant-numeric: lining-nums;
    text-decoration: none;
  }

  .phone :global(svg) {
    color: var(--color-primary);
  }

  .external {
    display: flex;
    align-items: center;
    gap: 0.4rem;
    margin-top: 1rem;
    font-weight: 500;
  }

  @media (max-width: 960px) {
    .booking-grid {
      grid-template-columns: 1fr;
    }

    .aside {
      position: static;
    }
  }

  @media (max-width: 560px) {
    .fields {
      grid-template-columns: 1fr;
    }

    #booking-form .btn {
      justify-self: stretch;
    }
  }
</style>
