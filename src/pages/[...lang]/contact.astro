---
import Mail from '@lucide/astro/icons/mail';
import MapPin from '@lucide/astro/icons/map-pin';
import Smartphone from '@lucide/astro/icons/smartphone';
import TrainFront from '@lucide/astro/icons/train-front';
import PageHeader from '../../components/PageHeader.astro';
import Layout from '../../layouts/Layout.astro';
import headerImage from '../../assets/images/pier.jpg';
import { hotel } from '../../data/hotel';
import { localeStaticPaths, useTranslations, type Locale } from '../../i18n';

// Maakt deze pagina aan in elke taal: /contact/, /fr/contact/, /en/contact/ en /de/contact/
export const getStaticPaths = localeStaticPaths;

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const t = useTranslations(locale);
---

<Layout locale={locale} title={t.contact.title} description={t.contact.description}>
  <PageHeader
    eyebrow={t.contact.eyebrow}
    title={t.contact.heading}
    intro={t.contact.intro}
    image={headerImage}
  />

  <section class="section" id="contact">
    <div class="container contact-grid">
      <div class="details">
        <h2>{t.contact.details}</h2>
        <ul class="contact-list">
          <li>
            <span class="icon"><MapPin size={20} /></span>
            <div>
              <strong>{t.contact.address}</strong>
              <a href={hotel.mapsUrl} target="_blank" rel="noopener">
                {hotel.name}<br />{hotel.address.street}<br />{hotel.address.postalCode} {hotel.address.city}
                <span class="sr-only">{t.common.mapsHint}</span>
              </a>
            </div>
          </li>
          <li>
            <span class="icon"><Smartphone size={20} /></span>
            <div>
              <strong>{t.contact.mobile}</strong>
              <a href={hotel.mobile.href}>{hotel.mobile.label}</a>
            </div>
          </li>
          <li>
            <span class="icon"><Mail size={20} /></span>
            <div>
              <strong>{t.contact.email}</strong>
              {hotel.emails.map((email) => <a href={`mailto:${email}`}>{email}</a>)}
            </div>
          </li>
        </ul>

        <p class="happytrip-note">
          <TrainFront size={22} />
          <span set:html={t.contact.happytripNoteHtml} />
        </p>
      </div>

      <div class="map card">
        <iframe
          src={hotel.mapEmbedUrl}
          title={t.contact.mapTitle}
          allowfullscreen=""
          loading="lazy"
          referrerpolicy="no-referrer-when-downgrade"
        ></iframe>
      </div>
    </div>
  </section>
</Layout>

<style>
  .contact-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: clamp(2rem, 5vw, 4rem);
    align-items: stretch;
  }

  h2 {
    margin-bottom: 1.75rem;
    font-size: clamp(1.9rem, 3vw, 2.4rem);
  }

  .contact-list {
    display: grid;
    gap: 1.5rem;
    padding: 0;
    list-style: none;
  }

  .contact-list li {
    display: flex;
    align-items: flex-start;
    gap: 1rem;
  }

  .contact-list div {
    display: grid;
    min-width: 0;
    overflow-wrap: anywhere;
  }

  .contact-list strong {
    font-size: 0.8rem;
    letter-spacing: 0.12em;
    text-transform: uppercase;
  }

  .contact-list a {
    color: var(--color-text);
    text-decoration: none;
  }

  .contact-list a:hover {
    color: var(--color-primary);
    text-decoration: underline;
  }

  .icon {
    display: inline-flex;
    flex-shrink: 0;
    align-items: center;
    justify-content: center;
    width: 46px;
    height: 46px;
    background-color: var(--color-primary-soft);
    color: var(--color-primary);
    border-radius: 999px;
  }

  .happytrip-note {
    display: flex;
    align-items: center;
    gap: 1rem;
    margin-top: 2.5rem;
    padding: 1.25rem 1.5rem;
    background-color: var(--color-sand);
    border-radius: var(--radius);
  }

  .happytrip-note :global(svg) {
    flex-shrink: 0;
    color: var(--color-primary);
  }

  .map {
    overflow: hidden;
  }

  /* De kaart vult de hoogte van de contactgegevens ernaast */
  .map iframe {
    display: block;
    width: 100%;
    height: 100%;
    min-height: 420px;
    border: 0;
  }

  @media (max-width: 860px) {
    .contact-grid {
      grid-template-columns: 1fr;
    }

    .map iframe {
      height: auto;
      min-height: 0;
      aspect-ratio: 1 / 1;
    }
  }
</style>
