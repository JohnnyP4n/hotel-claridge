---
import Baby from '@lucide/astro/icons/baby';
import Check from '@lucide/astro/icons/check';
import Coffee from '@lucide/astro/icons/coffee';
import Gift from '@lucide/astro/icons/gift';
import Info from '@lucide/astro/icons/info';
import ReceiptEuro from '@lucide/astro/icons/receipt-euro';
import CtaBand from '../../components/CtaBand.astro';
import PageHeader from '../../components/PageHeader.astro';
import Layout from '../../layouts/Layout.astro';
import headerImage from '../../assets/images/familiekamer.jpeg';
import { bookingPath } from '../../data/hotel';
import { extraBeds, rooms } from '../../data/rooms';
import { localePath, localeStaticPaths, useTranslations, type Locale } from '../../i18n';

// Maakt deze pagina aan in elke taal: /tarieven/, /fr/tarieven/, /en/tarieven/ en /de/tarieven/
export const getStaticPaths = localeStaticPaths;

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const t = useTranslations(locale);
---

<Layout locale={locale} title={t.rates.title} description={t.rates.description}>
  <PageHeader
    eyebrow={t.rates.eyebrow}
    title={t.rates.heading}
    intro={t.rates.intro}
    image={headerImage}
  />

  <section class="section" id="rates">
    <div class="container">
      <div class="table-card card">
        <table class="rates-table">
          <caption class="sr-only">{t.rates.tableCaption}</caption>
          <thead>
            <tr>
              <th scope="col">{t.rates.roomType}</th>
              <th scope="col">{t.rates.lowSeason} <span>{t.common.from}</span></th>
              <th scope="col">{t.rates.highSeason} <span>{t.common.from}</span></th>
            </tr>
          </thead>
          <tbody>
            {rooms.map((room) => (
              <tr>
                <th scope="row">
                  <a href={localePath(locale, `/kamers/#${room.id}`)}>
                    {room.showCode ? `${room.code}: ${t.rooms.items[room.id].name}` : t.rooms.items[room.id].name}
                  </a>
                  <span>{t.rooms.items[room.id].summary}</span>
                </th>
                <td data-label={`${t.rates.lowSeason} ${t.common.from}`}>&euro; {room.price.low}</td>
                <td data-label={`${t.rates.highSeason} ${t.common.from}`}>&euro; {room.price.high}</td>
              </tr>
            ))}
          </tbody>
        </table>
        <p class="table-note">
          <Info size={18} />
          <span>{t.rates.note}</span>
        </p>
      </div>

      <div class="promo card">
        <span class="promo-icon"><Gift size={26} /></span>
        <div class="promo-text">
          <p class="promo-eyebrow">{t.rates.promo.eyebrow}</p>
          <h2>{t.rates.promo.title}</h2>
          <p>{t.rates.promo.text}</p>
        </div>
        <a href={bookingPath(locale)} class="btn btn-primary">{t.nav.book}</a>
      </div>

      <div class="info-grid">
        <div class="info card">
          <span class="info-icon"><Baby size={22} /></span>
          <h2>{t.rates.extraBeds.title}</h2>
          <p class="muted">{t.rates.extraBeds.note}</p>
          <ul class="price-list">
            {extraBeds.map((bed) => (
              <li>
                <span>{t.rates.extraBeds.items[bed.id]}</span>
                {bed.price === null
                  ? <strong>{t.common.free}</strong>
                  : <span class="bed-price"><strong>&euro; {bed.price}</strong> <small>{t.common.perNight}</small></span>}
              </li>
            ))}
          </ul>
        </div>

        <div class="info card">
          <span class="info-icon"><Coffee size={22} /></span>
          <h2>{t.rates.included.title}</h2>
          <ul class="check-list">
            {t.rooms.includedItems.map((item) => <li><Check size={17} /> {item}</li>)}
          </ul>
          <p class="muted extra" set:html={t.rates.included.extraHtml} />
        </div>

        <div class="info card">
          <span class="info-icon"><ReceiptEuro size={22} /></span>
          <h2>{t.rates.touristTax.title}</h2>
          <p>{t.rates.touristTax.text}</p>
        </div>
      </div>
    </div>
  </section>

  <CtaBand locale={locale} />
</Layout>

<style>
  .table-card {
    overflow: hidden;
  }

  .rates-table {
    width: 100%;
    border-collapse: collapse;
  }

  .rates-table th,
  .rates-table td {
    padding: 1.25rem 1.75rem;
    text-align: left;
    vertical-align: middle;
  }

  .rates-table thead th {
    background-color: var(--color-primary);
    color: #fff;
    font-size: 0.85rem;
    font-weight: 600;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  .rates-table thead th span {
    display: block;
    color: rgb(255 255 255 / 0.75);
    font-size: 0.75rem;
    letter-spacing: 0.04em;
    text-transform: none;
  }

  .rates-table tbody tr + tr {
    border-top: 1px solid var(--color-line);
  }

  .rates-table tbody th {
    font-weight: 400;
  }

  .rates-table tbody th a {
    display: block;
    color: var(--color-heading);
    font-family: var(--font-serif);
    font-size: 1.35rem;
    font-weight: 600;
    text-decoration: none;
  }

  .rates-table tbody th a:hover {
    color: var(--color-primary);
  }

  .rates-table tbody th span {
    color: var(--color-muted);
    font-size: 0.95rem;
  }

  .rates-table td {
    color: var(--color-heading);
    font-family: var(--font-serif);
    font-variant-numeric: lining-nums;
    font-size: 1.6rem;
    font-weight: 700;
    white-space: nowrap;
  }

  .table-note {
    display: flex;
    align-items: flex-start;
    gap: 0.6rem;
    padding: 1rem 1.75rem;
    background-color: var(--color-sand);
    color: var(--color-text);
    font-size: 0.95rem;
  }

  .table-note :global(svg) {
    flex-shrink: 0;
    margin-top: 0.2rem;
    color: var(--color-primary);
  }

  .promo {
    display: flex;
    align-items: center;
    gap: 1.5rem;
    margin-top: 2rem;
    padding: 1.75rem 2rem;
    background-color: var(--color-primary-soft);
    border-left: 4px solid var(--color-primary);
  }

  .promo-icon {
    display: inline-flex;
    flex-shrink: 0;
    align-items: center;
    justify-content: center;
    width: 56px;
    height: 56px;
    background-color: var(--color-primary);
    color: #fff;
    border-radius: 999px;
  }

  .promo-text {
    flex: 1;
  }

  .promo-eyebrow {
    color: var(--color-primary);
    font-size: 0.8rem;
    font-weight: 600;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  .promo h2 {
    font-size: 1.6rem;
  }

  .promo h2 + p {
    margin-top: 0.35rem;
  }

  .promo .btn {
    flex-shrink: 0;
  }

  .info-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 1.5rem;
    margin-top: 2rem;
  }

  .info {
    padding: 2rem;
  }

  .info-icon {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 46px;
    height: 46px;
    margin-bottom: 1.25rem;
    background-color: var(--color-primary-soft);
    color: var(--color-primary);
    border-radius: 999px;
  }

  .info h2 {
    font-size: 1.6rem;
  }

  .muted {
    color: var(--color-muted);
  }

  .info h2 + p,
  .info h2 + ul {
    margin-top: 0.5rem;
  }

  .price-list,
  .check-list {
    margin-top: 1rem;
    padding: 0;
    list-style: none;
  }

  .price-list li {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    padding-block: 0.6rem;
    border-bottom: 1px dashed var(--color-line);
  }

  .price-list li:last-child {
    border-bottom: 0;
  }

  .price-list strong {
    white-space: nowrap;
  }

  .bed-price {
    display: grid;
    flex-shrink: 0;
    justify-items: end;
    line-height: 1.3;
  }

  .bed-price small {
    color: var(--color-muted);
    font-size: 0.8rem;
  }

  .check-list li {
    display: flex;
    align-items: center;
    gap: 0.6rem;
    padding-block: 0.25rem;
  }

  .check-list :global(svg) {
    color: var(--color-primary);
  }

  .extra {
    margin-top: 1rem;
    padding-top: 1rem;
    border-top: 1px solid var(--color-line);
  }

  @media (max-width: 1000px) {
    .info-grid {
      grid-template-columns: 1fr 1fr;
    }
  }

  /* Gsm: tabel als kaartjes */
  @media (max-width: 640px) {
    .rates-table thead {
      position: absolute;
      width: 1px;
      height: 1px;
      overflow: hidden;
      clip: rect(0, 0, 0, 0);
    }

    .rates-table tbody tr {
      display: grid;
      grid-template-columns: 1fr 1fr;
      padding: 1.25rem;
    }

    .rates-table tbody th {
      grid-column: 1 / -1;
      padding: 0 0 1rem;
    }

    .rates-table td {
      padding: 0;
      font-size: 1.4rem;
    }

    .rates-table td::before {
      content: attr(data-label);
      display: block;
      color: var(--color-muted);
      font-family: var(--font-sans);
      font-size: 0.78rem;
      font-weight: 600;
      letter-spacing: 0.06em;
      text-transform: uppercase;
    }

    .table-note {
      padding-inline: 1.25rem;
    }

    .promo {
      flex-direction: column;
      align-items: flex-start;
      padding: 1.5rem;
    }

    .info-grid {
      grid-template-columns: 1fr;
    }

    .info {
      padding: 1.5rem;
    }
  }
</style>
