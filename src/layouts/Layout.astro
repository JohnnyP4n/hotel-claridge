---
import { Font } from 'astro:assets';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { withBase } from '../utils/paths';
import '../styles/global.css';

interface Props {
  /** Paginatitel; zonder titel toont het tabblad enkel "Hotel Claridge" */
  title?: string;
  /** Korte omschrijving voor zoekmachines */
  description: string;
}

const { title, description } = Astro.props;
const pageTitle = title ? `${title} | Hotel Claridge` : 'Hotel Claridge | Charmant hotel in Blankenberge';
---

<!DOCTYPE html>
<html lang="nl">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>{pageTitle}</title>
  <meta name="description" content={description} />
  <meta name="theme-color" content="#245552" />
  <link rel="icon" href={withBase('/favicon.ico')} type="image/x-icon" />
  <Font cssVariable="--font-serif" preload />
  <Font cssVariable="--font-sans" preload />
</head>
<body>
  <a class="skip-link" href="#inhoud">Naar de inhoud</a>
  <Header />
  <main id="inhoud">
    <slot />
  </main>
  <Footer />
</body>
</html>
